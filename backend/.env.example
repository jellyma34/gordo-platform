APP_ENV=dev
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gordo_dev
# "*" → backend expands to Railway frontends + localhost (no wildcard with JWT).
# Or set explicitly, e.g.:
# CORS_ORIGINS=https://gordo-frontend-test.up.railway.app,http://localhost:3000
CORS_ORIGINS=*
SECRET_KEY=dev-insecure-change-me

# Optional: same value on Next.js service as INTERNAL_API_KEY for marketing server writes.
# INTERNAL_API_KEY=

# Bootstrap admin: создаётся при первом старте (см. backend/README.md).
BOOTSTRAP_ADMIN_EMAIL=marislova34@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=1234
# true — при каждом старте обновить пароль/роль существующего admin (только локально).
BOOTSTRAP_ADMIN_SYNC_ON_START=false

# Only for local troubleshooting.
LOGIN_DEBUG=false
