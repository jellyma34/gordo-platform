# Локальный `next dev`: базовый URL FastAPI (без /api в конце). Должен совпадать с портом uvicorn.
# Если переменная не задана, фронт в dev использует http://localhost:8000 (см. lib/apiClient.ts).
# Перекрытие: `.env.local` (не коммитить).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Реальный вход через backend (учётные данные — backend/.env: BOOTSTRAP_ADMIN_*).
NEXT_PUBLIC_AUTH_MOCK=false

# Construction SoT = PostgreSQL (как на Railway). Не ставить local для обычной разработки.
NEXT_PUBLIC_CONSTRUCTION_STORAGE=postgres
NEXT_PUBLIC_GPR_STORAGE=postgres
NEXT_PUBLIC_GPR_PROJECT_ID=verba-phase-1
